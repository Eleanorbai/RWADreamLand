# 数据库配置
DATABASE_URL=sqlite:///./rwa_dream_land.db

# 安全配置
# SECRET_KEY: 用于JWT token签名，可以使用以下命令生成：
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 区块链配置
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NODE_URL=http://127.0.0.1:20200
# BLOCKCHAIN_PRIVATE_KEY: FISCO BCOS账户私钥，可以从以下位置获取：
# 1. 使用FISCO BCOS控制台生成: cd ~/fisco/console && ./gen_account.sh
# 2. 或者使用现有账户: cat ~/fisco/console/accounts/account1.txt
# 注意：私钥格式为64位十六进制字符串，不包含0x前缀
BLOCKCHAIN_PRIVATE_KEY=your-private-key-here
# CONTRIBUTION_CONTRACT_ADDRESS: 部署合约后自动生成，运行 deploy_contract.py 获取
CONTRIBUTION_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890

# GitHub集成配置
GITHUB_ENABLED=true
# GITHUB_TOKEN: GitHub个人访问令牌，获取步骤：
# 1. 访问 https://github.com/settings/tokens
# 2. 点击 "Generate new token (classic)"
# 3. 选择权限：repo, workflow, admin:org
# 4. 生成并复制token
GITHUB_TOKEN=your-github-token-here
# GITHUB_WEBHOOK_SECRET: Webhook签名密钥，可以自定义，建议使用随机字符串
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(16))"
GITHUB_WEBHOOK_SECRET=rwa123456
GITHUB_DEFAULT_REPO=https://github.com/Eleanorbai/RWADreamLand.git

# 贡献积分配置
CONTRIBUTION_POINTS_BUG_REPORT=10
CONTRIBUTION_POINTS_FEATURE_REQUEST=15
CONTRIBUTION_POINTS_DOCUMENTATION=20
CONTRIBUTION_POINTS_CODE_CONTRIBUTION=50
CONTRIBUTION_POINTS_CRITICAL_FIX=100
CONTRIBUTION_POINTS_UI_UX_IMPROVEMENT=25
CONTRIBUTION_POINTS_TESTING=15
CONTRIBUTION_POINTS_OTHER=5

# 服务器配置
# HOST: 服务器监听地址，0.0.0.0表示监听所有网络接口
HOST=0.0.0.0
# PORT: 服务器端口，如果被占用可以修改为其他端口
PORT=8000
DEBUG=true

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log 